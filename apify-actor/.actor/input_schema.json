{
  "title": "HyperSignal input",
  "type": "object",
  "schemaVersion": 1,
  "properties": {
    "tool": {
      "title": "Tool",
      "type": "string",
      "description": "Which premium signal to run.",
      "editor": "select",
      "enum": [
        "hl_funding_screener",
        "hl_whale_positions",
        "hl_whale_flow_alerts",
        "hl_smart_money_score",
        "hl_portfolio_risk",
        "hl_polymarket_divergence"
      ],
      "enumTitles": [
        "Funding screener",
        "Whale positions",
        "Whale flow alerts",
        "Smart-money score",
        "Portfolio risk",
        "Polymarket divergence"
      ],
      "default": "hl_funding_screener"
    },
    "arguments": {
      "title": "Arguments",
      "type": "object",
      "description": "Tool arguments. E.g. {\"address\":\"0x...\"} for portfolio risk, {\"coin\":\"BTC\"} for Polymarket divergence.",
      "editor": "json",
      "default": {}
    }
  },
  "required": ["tool"]
}
