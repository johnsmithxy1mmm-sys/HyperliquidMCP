# =============================================================================
# HyperSignal MCP — environment configuration
# Copy to `.env`. ALL secrets live here and NOWHERE else (no secrets in code/logs).
# =============================================================================

# ---- Network -----------------------------------------------------------------
# mainnet | testnet  (testnet strongly recommended while validating trading)
HL_NETWORK=mainnet
# Optional overrides (defaults derived from HL_NETWORK):
# HL_WS_URL=wss://api.hyperliquid.xyz/ws

# ---- Core client tuning ------------------------------------------------------
HL_REQUEST_TIMEOUT_MS=10000
HL_MAX_RETRIES=3
HL_RATE_WEIGHT_PER_MIN=1100
HL_WS_ENABLED=true
LOG_LEVEL=info

# ---- HTTP server (remote / premium) ------------------------------------------
PORT=8080
MCP_HTTP_PATH=/mcp
# Per-IP request cap on the MCP endpoint (protects the Hyperliquid weight budget).
HTTP_RATE_LIMIT_PER_MIN=120
# Set true ONLY when deployed behind a reverse proxy (Fly.io, Nginx, Caddy) so
# client IPs come from X-Forwarded-For. Leave false for direct exposure.
TRUST_PROXY=false
# Opt-in CORS origin for browser-based MCP clients (empty = CORS disabled).
# MCP_CORS_ORIGIN=https://your-web-client.example

# ---- Storage -----------------------------------------------------------------
# SQLite holds billing (keys/counters) AND the warehouse (positioning
# snapshots, standing alerts, signal track record). Back this file up.
HYPERSIGNAL_DB_PATH=./data/hypersignal.db

# ---- Admin ---------------------------------------------------------------
# Secret required by hl_admin_stats (usage/revenue dashboard tool). Unset =
# tool is disabled. Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
HYPERSIGNAL_ADMIN_SECRET=

# ---- Alerts & signed signals -------------------------------------------------
# How often the standing-alert engine evaluates alerts + scores signals (seconds).
ALERT_INTERVAL_SEC=60
# Base64 of a 32-byte Ed25519 seed used to SIGN emitted signals (stable identity
# for the verifiable track record). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# If unset, an EPHEMERAL key is used (public key changes on restart).
SIGNAL_SIGNING_KEY=

# ---- Billing: API keys -------------------------------------------------------
# Provision keys at startup (comma-separated RAW keys; hashed before storage).
# Give these to customers; the server maps them to tiers.
HYPERSIGNAL_PRO_KEYS=
HYPERSIGNAL_FREE_KEYS=

# ---- Billing: x402 pay-per-call (USDC on Base) -------------------------------
X402_ENABLED=false
X402_PAY_TO=
X402_NETWORK=base
X402_ASSET=USDC
# Base mainnet USDC by default; override only if needed:
# X402_ASSET_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
X402_PRICE_PER_CALL_USDC=0.01
# Facilitator that verifies+settles payments. WITHOUT it, x402 fails closed.
X402_FACILITATOR_URL=

# ---- Polymarket cross-market analytics ---------------------------------------
# Gamma API base for hl_polymarket_divergence (prediction-market odds vs HL).
POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com

# ---- Whale cohort sourcing ---------------------------------------------------
# Cohort resolution order: `cohort` tool arg > auto-refreshed cohort (below) >
# HL_WHALE_ADDRESSES > direct leaderboard fetch.
#
# Canonical, reproducible source for whale tools (comma-separated 0x addresses).
# Always works, never goes stale, requires manual curation.
HL_WHALE_ADDRESSES=
# Optional best-effort public leaderboard (UNDOCUMENTED frontend endpoint — may
# change or disappear without notice). Setting this enables the background
# refresher below; every failure degrades to HL_WHALE_ADDRESSES.
# HL_LEADERBOARD_URL=https://stats-data.hyperliquid.xyz/Mainnet/leaderboard

# --- Automatic cohort refresh (only active when HL_LEADERBOARD_URL is set) ---
# Refresh period in minutes. Floor is 15 — the leaderboard moves slowly and the
# endpoint is unofficial, so there is no reason to hammer it.
HL_COHORT_REFRESH_MIN=60
# Ranking strategy: accountValue | pnlMonth | pnlAllTime
#   accountValue — biggest books (most stable, default)
#   pnlMonth     — hottest recent performers (noisier, momentum-biased)
#   pnlAllTime   — proven long-run operators
HL_COHORT_STRATEGY=accountValue
# How many wallets to keep in the cohort.
HL_COHORT_SIZE=60
# Minimum account equity (USD) to be eligible. Filters out dust accounts whose
# percentage returns look spectacular on a $200 book.
HL_COHORT_MIN_EQUITY=50000

# --- Score self-sampling (feeds hl_score_calibration) ------------------------
# The calibration harness can only prove or disprove the smart-money score once
# observations exist, and observations are created only when wallets are scored.
# Waiting for customer traffic means a quiet server never accumulates evidence —
# which is the very thing that would earn it traffic. So the server scores its
# own cohort on a schedule. Requires a cohort (HL_WHALE_ADDRESSES or the
# auto-refresh above); does nothing without one.
HL_SCORE_SAMPLE_ENABLED=true
# Hours between samples. Floor is 1; observations dedupe per UTC day anyway, so
# anything under 24 mostly just burns rate-limit budget.
HL_SCORE_SAMPLE_INTERVAL_HOURS=24
# Wallets per sample. Each costs ~2 API calls; work is chunked with pauses so it
# does not queue ahead of live requests.
HL_SCORE_SAMPLE_SIZE=40
# Delay before the first pass after boot (seconds, floor 60). Keeps startup
# quiet and gives the cohort refresher time to land.
HL_SCORE_SAMPLE_DELAY_SEC=300

# Optional vault addresses for hl_vault_screener (comma-separated 0x).
HL_VAULT_ADDRESSES=

# ---- Builder code (trading-tier revenue) -------------------------------------
# Your builder address that receives builder-code fees.
HL_BUILDER_ADDRESS=
# Builder fee in TENTHS of a basis point (f=10 => 1 bp). Cap for perps is 100 (10 bp).
HL_BUILDER_FEE_TENTHS_BPS=5

# ---- Trading tier (LOCAL / stdio ONLY — never remote) ------------------------
# Master switch. Even when true, remote HTTP mode never exposes trading tools.
HL_ENABLE_TRADING=false
# Agent-wallet private key. ONLY from env, ONLY used locally. NEVER commit this.
HL_AGENT_PRIVATE_KEY=
# Include premium tools locally (unmetered) for your own use with stdio:
HL_STDIO_INCLUDE_PREMIUM=false
